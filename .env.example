# Search
BRAVE_SEARCH_API_KEY=

# Optional cloud-provider defaults. UI-entered keys remain browser-local.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional thinking budget control for local reasoning models (default: 1000 initial, 30% follow-ups)
# THINK_BUDGET_INITIAL=1000
# THINK_BUDGET_FOLLOWUP_RATIO=0.30

# ── Run watchdog / stall protection ─────────────────────────────────────────
# Master switch (default on).
# RUN_WATCHDOG=false
# Ollama model-eviction stop: poll `ollama ps` and stop the run if the runtime
# unloads the model mid-generation (the classic OOM stall on shared memory).
# MODEL_EVICTION_WATCH=false
# MODEL_PS_INTERVAL_MS=60000
# MODEL_GONE_CHECKS_TO_KILL=2
# Proven-hang stop: zero tokens for STALL_QUIET_MS, then N zero-compute probes.
# On a 32 GB shared-memory laptop, 10 min quiet + 25 min per-turn is saner than
# the 30 min / 60 min defaults:
# STALL_QUIET_MS=600000
# TURN_MAX_DURATION_MS=1500000
# RUN_MAX_DURATION_MS=21600000
# WATCHDOG_IDLE_PROBES_TO_KILL=20
# WATCHDOG_PROBE_INTERVAL_MS=15000
